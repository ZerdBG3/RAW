function RAW_SpellDoesNotInterruptPerform()
    return SpellId('Shout_RAW_RegainHP_6')
        | SpellId('Shout_RAW_RegainHP_8')
        | SpellId('Shout_RAW_RegainHP_10')
        | SpellId('Shout_RAW_RegainHP_12')
        | SpellId('Shout_ArcaneRecovery')
        | SpellId('Shout_ArcaneRecovery_1')
        | SpellId('Shout_ArcaneRecovery_2')
        | SpellId('Shout_ArcaneRecovery_3')
        | SpellId('Shout_ArcaneRecovery_4')
        | SpellId('Shout_ArcaneRecovery_5')
        | SpellId('Shout_NaturalRecovery')
        | SpellId('Shout_NaturalRecovery_1')
        | SpellId('Shout_NaturalRecovery_2')
        | SpellId('Shout_NaturalRecovery_3')
        | SpellId('Shout_NaturalRecovery_4')
        | SpellId('Shout_NaturalRecovery_5')
end
